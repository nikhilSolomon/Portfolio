<%- include('_top', { title }) %>
<div class="page-head"><h1>Projects</h1><a class="btn primary" href="/admin/projects/new">+ New project</a></div>
<p class="muted">Drag the handle to reorder. Order is saved automatically and reflected on the site.</p>
<% if (!all.length) { %><p class="muted">No projects yet.</p><% } %>
<ul class="plist" id="plist" data-csrf="<%= csrf %>">
  <% all.forEach(p => { %>
  <li data-id="<%= p.id %>" draggable="true">
    <span class="handle" title="Drag to reorder">⋮⋮</span>
    <span class="thumb"><% if (p.cover) { %><img src="<%= p.cover %>" alt=""><% } else { %><i class="gen hue-<%= p.hue %>"></i><% } %></span>
    <span class="ptitle"><a href="/admin/projects/<%= p.id %>"><%= p.title %></a><small><%= p.kicker %><%= p.year ? ' · ' + p.year : '' %> · /work/<%= p.slug %></small></span>
    <span class="badges"><% if (p.featured) { %><b class="badge">Featured</b><% } %><b class="badge <%= p.status %>"><%= p.status %></b></span>
    <span class="acts">
      <form method="post" action="/admin/projects/<%= p.id %>/toggle"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn small"><%= p.status === 'draft' ? 'Publish' : 'Unpublish' %></button></form>
      <a class="btn small" href="/admin/projects/<%= p.id %>">Edit</a>
      <a class="btn small" href="/work/<%= p.slug %>" target="_blank">View</a>
    </span>
  </li>
  <% }) %>
</ul>
<%- include('_bottom') %>
