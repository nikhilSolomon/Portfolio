# Copy to .env and fill in. Nothing here is required to run locally.
PORT=3000
# Public URL of the site (used for sitemap, canonical and social preview links)
SITE_URL=https://nikhilsolomon.com
# Random long string; signs the login cookie. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string
# Where the SQLite DB and uploads live (mount a persistent disk here in production)
DATA_DIR=./data

# Optional: SMTP for contact-form email notifications. Without these, messages are
# still saved in the admin inbox, just not emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Portfolio <no-reply@nikhilsolomon.com>"
CONTACT_TO=
